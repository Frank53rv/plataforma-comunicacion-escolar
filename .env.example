# Tabla 30 · Variables de entorno del despliegue
#
# Copiá este archivo a .env y completá los valores propios de la instalación. Los
# valores de muestra NO son utilizables en ninguna instalación real: existen para que
# CP-RNF-19 pueda ejecutarse sobre un repositorio recién clonado sin editar ningún
# archivo del proyecto. El archivo .env nunca se versiona.

# Cadena de conexión al motor de base de datos, con credenciales propias de la
# instalación · RNF-19. El contenedor de la base se crea con las credenciales de esta
# misma cadena: reemplazá el usuario y la contraseña de muestra.
DATABASE_URL=postgres://usuario-de-la-instalacion:reemplazar-esta-credencial@db:5432/plataforma

# Clave de descifrado de las credenciales cifradas del framework · RNF-03 · ISO/IEC 27001
RAILS_MASTER_KEY=00000000000000000000000000000000

# Clave de firma y verificación del token de sesión · RF-01 · RNF-02
JWT_SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria

# Vigencia del token, no superior a veinticuatro horas · RNF-02
JWT_EXPIRACION_HORAS=24

# Identificación de la cuenta directiva semilla · RN-08 · RF-43
DIRECTIVO_CORREO=directivo@ejemplo.test

# Credencial provisional de la cuenta directiva, que se repone por esta vía y exige
# cambio en el primer acceso · RN-08 · RF-43
DIRECTIVO_CREDENCIAL_PROVISIONAL=cambiar-en-el-primer-acceso

# Identificación del proyecto en el servicio de notificaciones push · RF-31 · RF-32
FCM_PROJECT_ID=proyecto-de-ejemplo

# Credencial de servicio del proveedor de notificaciones push · RF-31 · RF-37
FCM_CREDENCIAL_JSON={}

# Nombre de dominio con el que el entorno se expone, condición del certificado
# válido · RNF-06 · RNF-19
APP_HOST=localhost

# Orígenes autorizados a consumir la interfaz desde el navegador · RNF-06 · RNF-21
CORS_ORIGENES=http://localhost:8080

# Plazo de conservación de la bitácora técnica de fallos de envío · RNF-07 · RN-27
RETENCION_BITACORA_MESES=12

# Valores de construcción del cliente web: identifican la aplicación web ante el servicio de
# notificaciones push y son públicos por diseño, a diferencia de FCM_CREDENCIAL_JSON ·
# RF-37 · RNF-11
VITE_FCM_API_KEY=reemplazar-por-la-clave-de-la-aplicacion-web
VITE_FCM_PROJECT_ID=proyecto-de-ejemplo
VITE_FCM_SENDER_ID=000000000000
VITE_FCM_APP_ID=reemplazar-por-el-identificador-de-la-aplicacion-web
VITE_VAPID_PUBLIC_KEY=reemplazar-por-la-clave-publica-vapid

