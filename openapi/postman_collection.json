{
  "info": {
    "name": "Plataforma de Comunicación Escolar · API v1",
    "description": "Colección de validación de la interfaz de programación (RNF-17 · CP-RNF-17).\n\nContiene las operaciones de la Tabla 18 que el enrutador expone hoy, agrupadas por caso de uso, con los cuerpos y parámetros que cada operación admite. Se amplía con cada módulo que se construye.\n\nConvenciones de la Tabla 28: identificadores UUID en rutas y cuerpos; JSON con los nombres de campo del diccionario de la Tabla 14; fechas ISO 8601 en tiempo universal coordinado; colecciones paginadas con `pagina` y `por_pagina` (25 por omisión, 100 como máximo), respondidas con `datos`, `total`, `pagina` y `por_pagina`.\n\nLos errores responden `application/problem+json` con uno de los nueve estados de la Tabla 24.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "CU-01 · Autenticarse",
      "item": [
        {
          "name": "Autenticar y emitir el token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sesiones",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sesiones"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{directivo_correo}}\",\n  \"contrasena\": \"{{directivo_contrasena}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "RF-01. Responde 201 con token, vence_en y usuario; el token queda guardado en la variable de entorno `token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar la sesión activa",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sesiones",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sesiones"
              ]
            },
            "description": "RF-01. Responde 204."
          }
        }
      ]
    },
