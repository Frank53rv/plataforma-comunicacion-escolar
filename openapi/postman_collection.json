          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/me/contrasena",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "me",
                "contrasena"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contrasena_actual\": \"\",\n  \"contrasena_nueva\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "RF-43."
          }
        }
      ]
    },
